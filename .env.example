# =============================================================
# HealthExpress Backend - Variables de Entorno de Ejemplo
# Copia este archivo a '.env' y completa con tus credenciales reales.
# NUNCA subas el archivo '.env' con contraseñas o tokens a GitHub.
# =============================================================

# Puerto del servidor NestJS
PORT=3000

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Clave secreta para firma y verificación de tokens JWT
JWT_SECRET=tu_clave_secreta_jwt_aqui

# Tiempo de expiración del token JWT (ej. 7d, 24h, 3600s)
JWT_EXPIRATION=7d

# Orígenes CORS permitidos (separados por coma para frontend React/Vite)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Conexión a Base de Datos PostgreSQL (Supabase o local)
# -------------------------------------------------------------
# Para Supabase (Connection string desde Supabase Dashboard > Project Settings > Database):
# Modo Transaction Pooler (puerto 6543):
# DATABASE_URL="postgresql://postgres.[TU_PROYECTO]:[TU_CONTRASENA]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Modo Conexión Directa (puerto 5432):
# DATABASE_URL="postgresql://postgres:[TU_CONTRASENA]@db.[TU_PROYECTO].supabase.co:5432/postgres"
#
# Para desarrollo local con Docker o PostgreSQL local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthexpress?schema=public"
