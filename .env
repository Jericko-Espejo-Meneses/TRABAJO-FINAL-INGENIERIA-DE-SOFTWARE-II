# Host Pooler IPv4: aws-0-us-east-1.pooler.supabase.com:5432
DATABASE_URL="postgresql://postgres.aibcplpyklgkacmkkywy:2026UlimaSFTW2@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"
